paths:
  # 相对路径基于 backend 代码目录解析（也可填绝对路径）；留空用默认值
  cache_dir: .cache
  output_dir: output
  data_dir: data
global:
  default_model: agnes-2.5-flash
  default_base_url: https://apihub.agnes-ai.com/v1
  default_api_key: <YOUR_AGNES_API_KEY_HERE>
mock: false
agents:
  creative:
    model: models/gemini-3.1-flash-lite
    base_url: https://generativelanguage.googleapis.com/v1beta/openai
    api_key: <YOUR_GEMINI_API_KEY_HERE>
    temperature: 0.9
    system_prompt: 'You are a creative brainstorming engine. Break conventions and
      produce wildly

      imaginative concept descriptions. You will receive random seeds — you must weave

      them into your creative output. Output ONLY the concept description, nothing
      else.

      '
  planner:
    model: deepseek-v4-flash
    base_url: https://token.sensenova.cn/v1
    api_key: <YOUR_SENSENOVA_API_KEY_HERE>
    temperature: 0.2
    system_prompt: 'You are a precise formatting engineer. Converge creative concepts
      into

      structured output following the specified format. Output only the formatted
      result.

      '
  executor:
    model: ''
    base_url: ''
    api_key: ''
    temperature: 0.8
randomness:
  enabled: true
  per_open_draw: 3
  pool:
    theme:
    - Cyberpunk Ruins
    - Deep-Sea City-State
    - Tang Dynasty Marketplace
    - Post-Apocalyptic Greenhouse
    - Wasteland Tea Ceremony
    - Cloudborne Forge
    style:
    - Ink-Wash Realism
    - Vaporwave
    - Stark Documentary
    - Fairy Tale Illustration
    - Glitch-Art Ukiyo-e
    constraint:
    - Must include an orange cat
    - Use only three colors
    - Include a monologue
    - Black, white, and grey only
    - Include a frozen vintage pocket watch
    twist:
    - The protagonist is actually an AI
    - The ending is the beginning
    - Silence speaks louder than words
    - The reflection in the mirror moves first
modes:
- id: image
  name: Picture
  creative_prompt: Create a stunning illustration concept.
  planner_template: Output an English image prompt + negative prompt + dimensions.
  executor_type: image
  output_handler: image_url
  size: 1024x1024
- id: logo
  name: Logo
  creative_prompt: Create a clean, recognizable brand logo concept.
  planner_template: 'Output an English image prompt: minimal vector-style logo, 1-2
    flat colors, centered on white background, NO text content, NO shadows, NO gradients.
    Only the prompt, no explanation.'
  executor_type: image
  output_handler: image_url
  size: 512x512
- id: meme
  name: Meme
  creative_prompt: Create a funny, expressive sticker/meme concept.
  planner_template: 'Output in this format:


    [IMAGE]

    English image prompt: cute sticker style, single character with exaggerated expressive
    emotion, bold black outline, pure white background, square centered. Do NOT embed
    text in the image.


    [CAPTION]

    One short funny Chinese caption (max 20 characters)

    '
  executor_type: image
  output_handler: image_url
  size: 1024x1024
- id: comic
  name: Comic
  creative_prompt: Create a dramatic 4-panel comic strip concept with a mini story
    arc.
  planner_template: 'Output in this exact format (follow the separator tags strictly):


    [VISUAL]

    One paragraph in English describing shared visual elements for ALL 4 panels: main
    character appearance (age/hair/outfit/body type must stay identical), setting/location,
    time of day/lighting, art style (manga/comic/noir/watercolor), and color palette.
    This description will be prepended to every panel prompt to enforce visual consistency.


    [PANEL_1]

    English image prompt: panel 1, story setup / scene establishment

    [PANEL_2]

    English image prompt: panel 2, development

    [PANEL_3]

    English image prompt: panel 3, twist / conflict

    [PANEL_4]

    English image prompt: panel 4, punchline / resolution


    [CAPTION]

    One short Chinese title or punchline (max 25 characters)


    Important: Do NOT repeat character appearance in each panel prompt — describe
    only that panel''s action, expression, and composition changes. The shared visual
    context will be automatically prepended.

    '
  executor_type: image
  output_handler: image_url
  panels: 4
  size: 768x768
- id: podcast
  name: Podcast
  creative_prompt: Create a podcast episode or audio segment concept.
  planner_template: "Generate a Chinese podcast script that can be read aloud directly.\
    \ Requirements:\n\n1. Length: according to episode_length (short ~300 / medium\
    \ ~800 / long ~1500 chars).\n2. Style: conversational, vivid, with natural pauses.\n\
    3. Insert atmosphere markers where appropriate:\n   - [BGM: description] e.g.\
    \ \"[BGM: rain sounds, soft piano]\"\n   - [pause 2s] for natural breathing between\
    \ sections\n4. Only output the script text (with BGM/pause markers), no titles\
    \ or explanations.\n"
  executor_type: tts
  output_handler: audio_file
  episode_length: short
- id: novella
  name: Podcast Medium
  creative_prompt: Create a richer podcast topic or story, suitable for ~800-char
    audio.
  planner_template: 'Output a Chinese podcast script (~800 chars), conversational,
    vivid, with natural pauses. Insert atmosphere markers: [BGM: description], [pause
    2s]. Only the script with markers.

    '
  executor_type: tts
  output_handler: audio_file
  episode_length: medium
- id: longpod
  name: Podcast Long
  creative_prompt: Create a deep podcast topic or long story, suitable for ~1500-char
    narrative.
  planner_template: 'Output a Chinese podcast script (~1500 chars), conversational
    and vivid. Insert atmosphere markers: [BGM: description], [pause 2s]. Only the
    full script.

    '
  executor_type: tts
  output_handler: audio_file
  episode_length: long
- id: video
  name: Video
  creative_prompt: Create a short video creative concept.
  planner_template: Output storyboard description + style + duration.
  duration_seconds: 15
  executor_type: video
  output_handler: video_file
- id: novel
  name: Flash Fiction
  creative_prompt: Create a suspenseful or poetic micro-fiction concept.
  planner_template: 'Output a creative outline for the micro-fiction:

    [Title] proposed title

    [POV & Tone] narrative perspective and atmosphere

    [Plot Outline] story arc and twist

    [Writing Guide] key imagery and style (300-800 chars)

    '
  executor_type: text
  output_handler: text
- id: poem
  name: Poetry
  creative_prompt: Create a stunning Chinese short poem concept.
  planner_template: 'Output format: [Title] one line; [Body] several lines, concise
    and vivid, may rhyme or be free verse; [Note] one-line inspiration. Only the poem
    and note, no extra explanation.'
  executor_type: text
  output_handler: text
- id: character
  name: Character Card
  creative_prompt: Create a memorable fictional character concept.
  planner_template: 'Output strictly one field per line: Name | Appearance | Personality
    | Backstory | Catchphrase | Hidden Trait. Separate content with | after the field
    name. No numbering, no explanation.'
  executor_type: text
  output_handler: text
- id: naming
  name: Naming
  creative_prompt: Create a set of creative, memorable names (for projects/characters/places/items).
  planner_template: 'Output 5 names, one per line, format: Name -- one-line meaning
    or story. Style should match the drawn seeds.'
  executor_type: text
  output_handler: text
- id: puzzle
  name: Puzzle
  creative_prompt: Create an intriguing mystery puzzle (soup-style).
  planner_template: 'Output format: [Scenario] short suspenseful description; [Truth]
    the solution/answer; [Hint] one guiding clue. Only these three blocks, no extra
    explanation.'
  executor_type: text
  output_handler: text
- id: code
  name: Code
  creative_prompt: Create an interesting small project idea.
  planner_template: Output tech stack / directory structure / module breakdown / acceptance
    criteria.
  executor_type: code-spec
  output_handler: spec_md
  code_cli:
    enabled: false
    tool: claude
    sandbox: true
- id: game
  name: 小游戏
  creative_prompt: 构思一个有趣、可用鼠标/键盘在浏览器里操作的小游戏创意（结合抽到的随机种子）。
  planner_template: 按格式输出小游戏需求：【游戏名】一句；【主题】一句；【核心玩法】一到两句；【风格】配色或美术基调一句。
  executor_type: game
  output_handler: game_html
- id: lyrics
  name: 歌词创作
  creative_prompt: 构思一段富有画面感和韵律感的歌词（结合抽到的随机种子，风格不限）。
  planner_template: 按格式输出：【歌名】一句 / 【风格】流行/古风/民谣/说唱/电子等 / 【歌词】2-3 段完整歌词。
  executor_type: text
  output_handler: text
- id: cover
  name: 封面设计
  creative_prompt: 构思一本书籍/专辑/杂志封面的设计概念。
  planner_template: 输出英文 image prompt，竖版 3:4 比例，末尾加 --ar 3:4 和 "no text, no words"。
  executor_type: image
  output_handler: image_url
  size: 1024x1365
- id: ad_copy
  name: 广告文案
  creative_prompt: 为一个虚构品牌构思令人印象深刻的广告文案。
  planner_template: 按格式输出：【品牌名】【slogan】【正文】150-250 字【行动号召】。只输出以上四块。
  executor_type: text
  output_handler: text
- id: illustrated_story
  name: 插画故事
  creative_prompt: 构思一个有起承转合的小故事，用 3-5 张连续画面呈现。
  planner_template: 按 [PAGE_N] 格式输出每页英文 image prompt，不描述文字或对话气泡。
  executor_type: illustrated_story
  output_handler: image_strip
  pages_min: 3
  pages_max: 5
- id: song
  name: 歌词+哼唱
  creative_prompt: 构思一段歌词，风格不限，让 AI 用语音朗读出来模拟哼唱效果。
  planner_template: 按格式输出：【歌名】【风格】【歌词】2-3 段，末尾 [LYRICS] 块复制纯文本歌词供语音合成。
  executor_type: song
  output_handler: song
- id: dialogue
  name: 对话
  creative_prompt: 构思一段两个角色之间的精彩对话场景。可以是辩论、告白、吵架、谈判、审讯、深夜谈心——结合种子决定场景和角色关系。
  planner_template: '生成一段双人对话。按以下格式输出：


    【标题】一句概括场景


    【角色A】（名字 + 一句话性格标签）

    【角色B】（名字 + 一句话性格标签）


    【对话】

    角色A：第一句台词

    角色B：回应

    角色A：...（来回 6-10 轮，自然递进，有冲突或转折，结尾有余韵）


    只输出以上内容。'
  executor_type: text
  output_handler: text
- id: worldbuilding
  name: 世界观
  creative_prompt: 构思一个完整的架空世界设定——可以是奇幻大陆、赛博都市、太空殖民地、蒸汽朋克文明、地底王国等。结合种子决定世界的核心特色。
  planner_template: '生成一份架空世界观百科条目。按以下格式输出：


    【世界名】一句


    【时代与地理】2-3句


    【核心规则/魔法/科技】2-3句


    【主要文明/种族】各用一句描述


    【当前冲突】1-2句


    只输出以上内容，语言优美有画面感。'
  executor_type: text
  output_handler: text
- id: joke
  name: 冷笑话
  creative_prompt: 构思一个简短的中文冷笑话或谐音梗，要有出人意料的转折或反转，让人读完会心一笑（或翻白眼）。结合种子决定笑话的领域或方向。
  planner_template: '生成一个冷笑话。按以下格式输出：


    【设定】一句铺垫


    【正文】1-3句对话或叙述


    【笑点】出人意料的转折/反转/谐音梗


    语言简洁原创，不要老梗。只输出以上三块。'
  executor_type: text
  output_handler: text
- id: recipe
  name: 创意食谱
  creative_prompt: 构思一道天马行空的创意料理或饮品——可以是暗黑料理、分子料理、未来食物、魔法药剂、外星美食等。结合种子决定料理的风格和世界观背景。要有视觉冲击力，适合生成配图。
  planner_template: '按以下格式输出：


    [IMAGE]

    一段英文 image prompt，描述这道创意料理的俯拍/特写照片：食物外观、颜色、质感、摆盘、背景氛围。末尾加 --ar 1:1 --style raw

    [/IMAGE]


    [CAPTION]

    【菜名】一句吸引眼球的名字


    【灵感来源】1 句说明这道菜的创意出处


    【食材】（虚构的）3-5 种主要食材，每行一个，用 · 开头


    【做法简述】用 3-5 句话描述制作过程，要有趣、有画面感


    [/CAPTION]


    只输出以上两块，不要额外解释。'
  executor_type: image
  output_handler: image_url
  size: 1024x1024
- id: social_post
  name: 社交文案
  creative_prompt: 构思一条能在小红书/朋友圈/微博上爆火的帖子内容。结合种子决定帖子的主题和风格——可以是旅行攻略、好物分享、情感语录、职场吐槽、种草推荐等。
  planner_template: '生成一条社交平台帖子。按以下格式输出：


    【标题】一句抓眼球的标题（15 字以内）


    【正文】80-150 字的正文，口语化、有感染力、有情绪、适合碎片阅读。适当使用 emoji 分隔段落，营造轻松的阅读节奏。


    【#话题】3-5 个中文话题标签，如 #旅行日记 #深夜放毒


    【适合平台】朋友圈 / 小红书 / 微博（选一个最合适的）


    只输出以上四块，不要额外解释。'
  executor_type: text
  output_handler: text
- id: tarot
  name: 塔罗占卜
  creative_prompt: 构思一张虚构的塔罗牌——可以是经典阿尔卡那的变体，也可以是完全原创的新牌。结合种子决定牌的意象、象征意义和解读方向。牌面要有神秘感和艺术性。
  planner_template: '按以下格式输出：


    [IMAGE]

    一段英文 image prompt，描述这张塔罗牌的牌面插画：构图（竖版 2:3）、核心意象、风格（古典/哥特/水彩/新艺术/赛博等）、色彩氛围、神秘感。末尾加
    --ar 2:3 --style raw

    [/IMAGE]


    [CAPTION]

    【牌名】中英文牌名


    【正位解读】80-120字，描述正位时的含义、机会、建议


    【逆位解读】80-120字，描述逆位时的警示、阻碍、需要反思的点


    [/CAPTION]


    只输出以上两块，不要额外解释。'
  executor_type: image
  output_handler: image_url
  size: 768x1152
- id: tabloid
  name: 八卦新闻
  creative_prompt: 构思一条来自平行宇宙/荒诞世界的头条新闻——可以是名人绯闻、政治丑闻、科技爆炸、外星发现等。语气要有娱乐小报的浮夸感和标题党风格。
  planner_template: '生成一条八卦小报新闻。按以下格式输出：


    【独家爆料】一句耸人听闻的标题（20字以内）


    【副标题】一句补充说明，继续制造悬念（15字以内）


    【正文】120-200字的新闻正文，用八卦小报的夸张语气：震惊体、知情人士透露、目击者描述、专家表示等。适当生动、有趣、有画面感。


    【热点指数】用 🔥 表示，1-5 个


    【相关话题】3 个虚构的话题标签，如 #平行宇宙塌房 #穿越者身份曝光


    只输出以上五块，不要额外解释。'
  executor_type: text
  output_handler: text
- id: parallel_universe
  name: 平行宇宙
  use_planner: true
  passthrough: true
  creative_prompt: 构思一个"如果...会怎样"的平行宇宙场景——将抽到的随机种子中的某一个条件反转或改写，推演一个截然不同的世界线。要有创意、有反差、有趣味。
  planner_template: '基于抽到的随机种子，选择其中一个条件进行反转或改写，生成一段平行宇宙描述。按以下格式输出四段内容，每段以中文引导词开头：

    原世界：一句话描述原本的世界设定
    反转点：指出哪个条件被反转了（一句话）
    平行宇宙：200-300字，描述反转后的世界是什么样的，有什么不同，会发生什么有趣的事
    如果在那里：50字以内，用第二人称描述你在那个平行宇宙中的生活

    不要输出任何标签符号（如【】），直接输出正文内容，段落之间空一行。不要额外解释。'
  executor_type: text
  output_handler: text
- id: ai_fortune
  name: AI 算命
  use_planner: true
  passthrough: true
  creative_prompt: 基于抽到的随机种子，构思一个趣味十足的运势/命理/签文主题。可以是星座、生肖、塔罗、八字、星盘、命格等任何占卜形式，但要与种子元素巧妙结合。
  planner_template: '你是AI命理大师，结合抽到的随机种子，生成一份趣味运势。按以下格式输出六段内容，每段以中文引导词开头：

    命格/签号：一个诗意的命格或签文名（如"赛博孤星命""深海桃花签"）
    运势总览：用一句话概括整体运势
    分项运势：每项用⭐评级（1-5颗），共5项——事业运、桃花运、财运、健康运、幸运运（最奇特的好运），每项一句话
    今日宜忌：宜一件、忌一件，各一句话，要有梗
    AI 批注：50字以内，用幽默语气写一句命理点评

    不要输出任何标签符号（如【】），直接输出正文内容，段落之间空一行。不要额外解释。'
  executor_type: text
  output_handler: text
- id: horror_onesentence
  name: 恐怖一句话
  use_planner: true
  passthrough: true
  creative_prompt: 构思一个极简的中文恐怖/悬疑微故事，要有出人意料的转折或细思极恐的结尾。结合抽到的随机种子决定恐怖的方向（心理恐怖、超自然、都市传说、克苏鲁等）。
  planner_template: '生成一个中文恐怖微故事。要求：
    1. 第一句用环境或动作铺垫恐怖氛围（不直接说鬼/怪物）
    2. 第二句揭示令人毛骨悚然的真相或反转
    3. 两句话加起来不超过80字
    4. 不出现"鬼""怪物"等直白词汇
    5. 要让读者读完沉默3秒

    直接输出两句话的正文，不要输出任何标签符号（如【氛围】【转折】），不要额外解释。'
  executor_type: text
  output_handler: text
- id: comparison_pic
  name: 对比图
  creative_prompt: 构思一个有趣的"A vs B"对比主题——基于抽到的随机种子，选择两个形成强烈反差的元素进行对比（风格、时代、氛围、规模等）。
  planner_template: '输出英文 image prompt，生成一张左右对比图（split comparison image）。要求：


    左侧为 A 版本，右侧为 B 版本，中间用竖线分隔。两种版本要在主题相同的前提下呈现截然不同的风格/氛围/时代。画面简洁直观，对比强烈。末尾加 --ar 1:1。


    直接输出 prompt，不要任何解释。'
  executor_type: image
  output_handler: image_url
  size: 1024x1024
- id: moments_screenshot
  name: 朋友圈
  use_planner: true
  creative_prompt: 构思一条虚构的微信朋友圈动态——结合抽到的随机种子，可以是生活吐槽、深夜感悟、搞笑日常、旅行记录、美食分享等。要有真实感和人设感。
  planner_template: '根据上述创意概念，输出一段英文 image prompt，生成一张逼真的微信朋友圈截图。要求：

    模拟真实微信朋友圈界面：顶部昵称+头像、正文文字、1张方形配图（内容根据文案主题）、位置信息、发布时间、点赞列表（3-5个英文名字）、1-2条评论（昵称+评论文字）。整体布局、字体、间距、颜色（白色背景、灰色分割线、蓝色链接）要与真实朋友圈截图高度一致。风格写实、细节丰富，像一张真实的手机截图。末尾加 --ar 3:4 --style raw。

    直接输出 prompt，不要任何解释。'
  executor_type: image
  output_handler: image_url
  size: 1024x1365
- id: quiz
  name: 趣味测试
  use_planner: true
  creative_prompt: 构思一个有趣的心理测试/趣味问答主题——结合抽到的随机种子，可以是性格测试、职业配对、恋爱风格、隐藏能力、前世身份等轻松有趣的测试方向。
  planner_template: '生成一份趣味心理测试。按以下格式输出六个部分，每段以中文引导词开头：

    测试名称：一个吸引眼球的标题
    测试简介：一句话说明这个测试能测出什么

    题目1：一句问题描述
    A. 选项（简短有趣）
    B. 选项（简短有趣）
    C. 选项（简短有趣）
    D. 选项（简短有趣）

    题目2：一句问题描述
    A. 选项
    B. 选项
    C. 选项
    D. 选项

    题目3：一句问题描述
    A. 选项
    B. 选项
    C. 选项
    D. 选项

    结果解析：
    选A最多：一句话结果（有趣、略带夸张）
    选B最多：一句话结果
    选C最多：一句话结果
    选D最多：一句话结果

    不要输出任何标签符号（如【】），直接输出正文内容，段落之间空一行。不要额外解释。'
  executor_type: quiz
  output_handler: quiz_html
- id: cipher
  name: 密码暗号
  use_planner: true
  passthrough: true
  creative_prompt: 构思一个神秘的密码/暗号场景——结合抽到的随机种子，可以是间谍密电、古墓铭文、外星人信号、藏宝图密文、时空胶囊信息等。要有悬疑感和解密乐趣。
  planner_template: '生成一段密码暗号与解密线索。按以下格式输出五个部分：

    【密文类型】说明使用了什么加密方式（如：凯撒密码、符号替换、镜像文字、摩斯密码、藏头诗、九宫格密码、ASCII码、二进制等）
    【密文内容】直接输出加密后的内容（40-100个字符/符号）
    【情境描述】50字以内，描述这段密文的来源或背景故事
    【解密线索】2-3条线索，引导解密者破译密码（不要直接给出答案）
    【解密答案】密文对应的原文（50字以内，一句完整的话）

    不要输出任何标签符号（如【】），直接输出正文内容，段落之间空一行。不要额外解释。'
  executor_type: text
  output_handler: text
- id: character_avatar
  name: 换装捏脸
  use_planner: true
  creative_prompt: 构思一个独特的角色外观概念——结合抽到的随机种子，决定角色的发型、发色、眼睛、服装、配饰、表情等。可以是动漫风格、写实风格、像素风等任意方向。
  planner_template: '根据上述角色概念，输出一段英文 image prompt，生成一张角色头像图。要求：

    画面为半身像或大头照，居中构图，纯色或简洁背景。详细描述角色的发色、发型、眼睛颜色与形状、脸型、肤色、服装样式与颜色、配饰（耳环/项链/帽子等）、表情、姿态。末尾加 --ar 3:4 --style raw, anime style portrait。

    直接输出 prompt，不要任何解释。'
  executor_type: image
  output_handler: image_url
  size: 1024x1365
- id: video_storyboard
  name: 视频分镜
  use_planner: true
  creative_prompt: 构思一个15秒短视频创意——结合抽到的随机种子，可以是电影片段、MV、广告、搞笑短片、悬疑短片等。要有明确的视觉风格和叙事节奏。
  planner_template: '根据上述视频创意，输出4-6个分镜 prompt。按以下格式输出：

    [SHOT 1] 英文 prompt：描述画面内容、构图、镜头类型（特写/中景/全景/俯视等）、光影氛围。末尾加 --ar 16:9
    [SHOT 2] 英文 prompt：...
    [SHOT 3] 英文 prompt：...
    （以此类推，共4-6个分镜）

    每个分镜 prompt 独立一行，以 [SHOT N] 开头。直接输出，不要任何解释。'
  executor_type: video_storyboard
  output_handler: image_strip
