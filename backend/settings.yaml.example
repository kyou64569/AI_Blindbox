# =============================================================================
#  AI Blind Box — Configuration Template
# =============================================================================
#  Copy this file to settings.yaml and fill in your own API keys.
#  settings.yaml is in .gitignore — your real keys will never be committed.
# =============================================================================

paths:
  # Storage directories (change D:/work/AI_Blindbox to your project root)
  cache_dir: D:/work/AI_Blindbox/.cache
  output_dir: D:/work/AI_Blindbox/output
  data_dir: D:/work/AI_Blindbox/data

# ---------------------------------------------------------------------------
#  Global defaults (used as fallback by all agents)
# ---------------------------------------------------------------------------
global:
  default_model: agnes-2.5-flash
  default_base_url: https://apihub.agnes-ai.com/v1
  default_api_key: "<YOUR_AGNES_API_KEY_HERE>"
  pipeline_mode: standard                 # "standard" (3 agents) or "lite" (2 agents)

# Set to true for demo mode (no API calls, uses mock outputs)
mock: false

# ---------------------------------------------------------------------------
#  Agent configurations — each agent can override the global defaults
# ---------------------------------------------------------------------------
agents:
  creative:
    model: models/gemini-3.1-flash-lite
    base_url: https://generativelanguage.googleapis.com/v1beta/openai
    api_key: "<YOUR_GEMINI_API_KEY_HERE>"
    temperature: 0.9
    system_prompt: |
      You are a creative brainstorming engine. Break conventions and produce wildly
      imaginative concept descriptions. You will receive random seeds — you must weave
      them into your creative output. Output ONLY the concept description, nothing else.

  planner:
    model: deepseek-v4-flash
    base_url: https://token.sensenova.cn/v1
    api_key: "<YOUR_SENSENOVA_API_KEY_HERE>"
    temperature: 0.2
    system_prompt: |
      You are a precise formatting engineer. Converge creative concepts into
      structured output following the specified format. Output only the formatted result.

  executor:
    model: ""
    base_url: ""
    api_key: ""
    temperature: 0.8

# ---------------------------------------------------------------------------
#  Random seed pool — dimensions and their available entries
# ---------------------------------------------------------------------------
randomness:
  enabled: true
  per_open_draw: 3
  pool:
    theme:
      - Cyberpunk Ruins
      - Deep-Sea City-State
      - Tang Dynasty Marketplace
      - Post-Apocalyptic Greenhouse
      - Wasteland Tea Ceremony
      - Cloudborne Forge
    style:
      - Ink-Wash Realism
      - Vaporwave
      - Stark Documentary
      - Fairy Tale Illustration
      - Glitch-Art Ukiyo-e
    constraint:
      - Must include an orange cat
      - Use only three colors
      - Include a monologue
      - Black, white, and grey only
      - Include a frozen vintage pocket watch
    twist:
      - The protagonist is actually an AI
      - The ending is the beginning
      - Silence speaks louder than words
      - The reflection in the mirror moves first

# ---------------------------------------------------------------------------
#  Output modes — each defines how the blind box pipeline works
# ---------------------------------------------------------------------------
modes:
  - id: image
    name: Picture
    creative_prompt: Create a stunning illustration concept.
    planner_template: Output an English image prompt + negative prompt + dimensions.
    executor_type: image
    output_handler: image_url
    size: 1024x1024

  - id: logo
    name: Logo
    creative_prompt: Create a clean, recognizable brand logo concept.
    planner_template: "Output an English image prompt: minimal vector-style logo, 1-2 flat colors, centered on white background, NO text content, NO shadows, NO gradients. Only the prompt, no explanation."
    executor_type: image
    output_handler: image_url
    size: 512x512

  - id: meme
    name: Meme
    creative_prompt: Create a funny, expressive sticker/meme concept.
    planner_template: |
      Output in this format:

      [IMAGE]
      English image prompt: cute sticker style, single character with exaggerated expressive emotion, bold black outline, pure white background, square centered. Do NOT embed text in the image.

      [CAPTION]
      One short funny Chinese caption (max 20 characters)
    executor_type: image
    output_handler: image_url
    size: 1024x1024

  - id: comic
    name: Comic
    creative_prompt: Create a dramatic 4-panel comic strip concept with a mini story arc.
    planner_template: |
      Output in this exact format (follow the separator tags strictly):

      [VISUAL]
      One paragraph in English describing shared visual elements for ALL 4 panels: main character appearance (age/hair/outfit/body type must stay identical), setting/location, time of day/lighting, art style (manga/comic/noir/watercolor), and color palette. This description will be prepended to every panel prompt to enforce visual consistency.

      [PANEL_1]
      English image prompt: panel 1, story setup / scene establishment
      [PANEL_2]
      English image prompt: panel 2, development
      [PANEL_3]
      English image prompt: panel 3, twist / conflict
      [PANEL_4]
      English image prompt: panel 4, punchline / resolution

      [CAPTION]
      One short Chinese title or punchline (max 25 characters)

      Important: Do NOT repeat character appearance in each panel prompt — describe only that panel's action, expression, and composition changes. The shared visual context will be automatically prepended.
    executor_type: image
    output_handler: image_url
    panels: 4
    size: 768x768

  - id: podcast
    name: Podcast
    creative_prompt: Create a podcast episode or audio segment concept.
    planner_template: |
      Generate a Chinese podcast script that can be read aloud directly. Requirements:

      1. Length: according to episode_length (short ~300 / medium ~800 / long ~1500 chars).
      2. Style: conversational, vivid, with natural pauses.
      3. Insert atmosphere markers where appropriate:
         - [BGM: description] e.g. "[BGM: rain sounds, soft piano]"
         - [pause 2s] for natural breathing between sections
      4. Only output the script text (with BGM/pause markers), no titles or explanations.
    executor_type: tts
    output_handler: audio_file
    episode_length: short
  - id: novella
    name: Podcast Medium
    creative_prompt: Create a richer podcast topic or story, suitable for ~800-char audio.
    planner_template: |
      Output a Chinese podcast script (~800 chars), conversational, vivid, with natural pauses. Insert atmosphere markers: [BGM: description], [pause 2s]. Only the script with markers.
    executor_type: tts
    output_handler: audio_file
    episode_length: medium
  - id: longpod
    name: Podcast Long
    creative_prompt: Create a deep podcast topic or long story, suitable for ~1500-char narrative.
    planner_template: |
      Output a Chinese podcast script (~1500 chars), conversational and vivid. Insert atmosphere markers: [BGM: description], [pause 2s]. Only the full script.
    executor_type: tts
    output_handler: audio_file
    episode_length: long

  - id: video
    name: Video
    creative_prompt: Create a short video creative concept.
    planner_template: Output storyboard description + style + duration.
    duration_seconds: 15
    executor_type: video
    output_handler: video_file

  - id: novel
    name: Flash Fiction
    creative_prompt: Create a suspenseful or poetic micro-fiction concept.
    planner_template: |
      Output a creative outline for the micro-fiction:
      [Title] proposed title
      [POV & Tone] narrative perspective and atmosphere
      [Plot Outline] story arc and twist
      [Writing Guide] key imagery and style (300-800 chars)
    executor_type: text
    output_handler: text

  - id: poem
    name: Poetry
    creative_prompt: Create a stunning Chinese short poem concept.
    planner_template: "Output format: [Title] one line; [Body] several lines, concise and vivid, may rhyme or be free verse; [Note] one-line inspiration. Only the poem and note, no extra explanation."
    executor_type: text
    output_handler: text

  - id: character
    name: Character Card
    creative_prompt: Create a memorable fictional character concept.
    planner_template: "Output strictly one field per line: Name | Appearance | Personality | Backstory | Catchphrase | Hidden Trait. Separate content with | after the field name. No numbering, no explanation."
    executor_type: text
    output_handler: text

  - id: naming
    name: Naming
    creative_prompt: Create a set of creative, memorable names (for projects/characters/places/items).
    planner_template: "Output 5 names, one per line, format: Name -- one-line meaning or story. Style should match the drawn seeds."
    executor_type: text
    output_handler: text

  - id: puzzle
    name: Puzzle
    creative_prompt: Create an intriguing mystery puzzle (soup-style).
    planner_template: "Output format: [Scenario] short suspenseful description; [Truth] the solution/answer; [Hint] one guiding clue. Only these three blocks, no extra explanation."
    executor_type: text
    output_handler: text

  - id: code
    name: Code
    creative_prompt: Create an interesting small project idea.
    planner_template: Output tech stack / directory structure / module breakdown / acceptance criteria.
    executor_type: code-spec
    output_handler: spec_md
    code_cli:
      enabled: false
      tool: claude
      sandbox: true

# ---------------------------------------------------------------------------
#  Provider credentials for external execution APIs
# ---------------------------------------------------------------------------
providers:
  image:
    base_url: https://apihub.agnes-ai.com/v1
    api_key: "<YOUR_AGNES_API_KEY_HERE>"
    model: agnes-image-2.0-flash

  video:
    base_url: https://apihub.agnes-ai.com/v1
    api_key: "<YOUR_AGNES_API_KEY_HERE>"
    model: agnes-video-v2.0

  tts:
    # Default: Edge TTS (free, no API key needed, good Chinese voice).
    # To switch to cloud TTS (OpenAI / Fish Audio, etc.), change engine and fill base_url / api_key / model / voice.
    engine: edge-tts
    voice: zh-CN-XiaoxiaoNeural
    base_url: ""
    api_key: ""
    model: ""
